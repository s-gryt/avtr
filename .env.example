# Copy to .env. All values optional; defaults shown.

# Ollama endpoint. Default reaches host-native Ollama from inside the container.
# Ollama runs natively on the host, not in Docker.
OLLAMA=http://host.docker.internal:11434

# Chat model. Must support tool calling (check: `ollama show <model>`).
MODEL=gemma4:e4b-it-q4_K_M

# Speech-to-text model; choose an Ollama model with audio capability.
STT_MODEL=gemma4:e4b-it-q4_K_M

# Kokoro TTS voice
VOICE=af_heart

# Host port the app is published on (container always listens on 8000). Published on 127.0.0.1 only;
# set BIND=0.0.0.0 to expose on the LAN (no authentication: do that only on a trusted network).
PORT=8000
BIND=127.0.0.1
